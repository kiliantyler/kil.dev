    "ai": "6.0.196",
    "babel-plugin-react-compiler": "1.0.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.39.1",
    "date-fns": "4.3.0",
    "exifr": "7.1.3",
    "iron-session": "8.0.4",
    "jose": "6.2.3",
    "js-cookie": "3.0.7",
    "lucide-react": "1.16.0",
    "motion": "12.38.0",
    "next": "16.2.6",
