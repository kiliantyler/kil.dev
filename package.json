    "yet-another-react-lightbox": "3.32.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "knip": "6.14.1",
    "oxlint": "1.65.0",
