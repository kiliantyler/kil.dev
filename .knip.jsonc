{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/(page|layout|template|default|head|error|global-error|not-found|loading).{ts,tsx,js,jsx}",
    "src/app/**/(route|sitemap|robots).{ts,js}",
    "convex/**/*.{ts,js}",
    "scripts/**/*.{ts,js}"
  ],
  "project": [
    "convex/**/*.{ts,js}",
    "src/**/*.{ts,tsx,js,jsx,d.ts}",
    "scripts/**/*.{ts,js}",
    "src/styles/**/*.css"
  ],
  "ignoreDependencies": [],
  "ignore": [
    "src/utils/presence-script.ts",
    "src/utils/theme-script.ts"
  ]
}
