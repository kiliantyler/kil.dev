# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.


NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
CONVEX_GAME_WRITE_SECRET=
VERCEL_PROJECT_ID=
# Vercel AI Gateway key used by Convex RAG embedding actions.
# In Vercel-hosted Next.js routes, VERCEL_OIDC_TOKEN may be available, but Convex actions need AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
ASK_KILIAN_CONVEX_ACCESS_TOKEN=
ASK_KILIAN_GATEWAY_ENV=
ASK_KILIAN_EMBEDDING_MODEL=alibaba/qwen3-embedding-4b
ASK_KILIAN_EMBEDDING_DIMENSIONS=2048
BLOB_READ_WRITE_TOKEN=
PET_GALLERY_CONVEX_ACCESS_TOKEN=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=
WORKOS_ACTION_SECRET=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
PET_GALLERY_WORKOS_ORG_ID=
PET_GALLERY_ADMIN_EMAIL=
UPLOADTHING_TOKEN=
